{
  // TrailZ mobile web app: one Worker serves the React app and the /api routes.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trailz-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Logs are kept (persist) so failures can be read in the dashboard under Workers → trailz-app → Logs.
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true }
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trailz-app",
      // The D1 database created in the Cloudflare dashboard.
      "database_id": "613ed925-df72-44d4-9d17-30ec98875c8f",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Workers AI: backup model when Gemini is overloaded (no extra key needed).
  "ai": { "binding": "AI" },
  "vars": {
    // "1" = use built-in sample results instead of calling Supadata / Gemini.
    "MOCK_AI": "0",
    // Paid AI checks allowed per device per day (cached results and bad links are free).
    "DAILY_LIMIT": "10",
    // Models to try in order, comma-separated. If Google retires one (or a new API key may not
    // use it), the next one is used. Check https://ai.google.dev/gemini-api/docs/models
    "GEMINI_MODEL": "gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash",
    // Optional: route Gemini through Cloudflare AI Gateway, e.g.
    // https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/google-ai-studio
    // Backup model on Cloudflare Workers AI, used only when no Gemini model answers. "" turns it off.
    "FALLBACK_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "GEMINI_BASE_URL": "https://generativelanguage.googleapis.com",
    // Contact address sent to OpenStreetMap's geocoder (required by its usage policy).
    "GEOCODER_CONTACT": "[YOUR CONTACT EMAIL]",
    // Partner affiliate ids: fill in once each partner program is approved (links work without them).
    "KIWI_AFFILIATE_ID": "",
    "BOOKING_AFFILIATE_ID": "",
    "GYG_PARTNER_ID": "",
    "OMIO_PARTNER_ID": "",
    // Travelpayouts (one account for Kiwi.com, Booking.com, GetYourGuide, Omio …). From the long version of any
    // Travelpayouts link: marker=TP_MARKER, trs=TP_TRS, and p=<campaign id> per brand. Empty = plain partner links.
    "GOOGLE_CLIENT_ID": "892982400205-2cvganv2su3ugjf6p2f65a4em8fpmdft.apps.googleusercontent.com",
    "TP_MARKER": "789861",
    "TP_TRS": "585453",
    "TP_KIWI_P": "",
    "TP_BOOKING_P": "",
    "TP_GYG_P": "",
    "TP_OMIO_P": "",
    // Live price providers (keys are secrets, see above). SerpApi free plan = 250 searches/month.
    "SERPAPI_MONTHLY_LIMIT": "250",
    "DUFFEL_MARKUP_RATE": "0.03",
    // With a test token Duffel returns a pretend airline; "1" shows it anyway (to try the checkout flow).
    "DUFFEL_ALLOW_TEST": "1"
  }
  // Secrets (set with `npx wrangler secret put NAME` or in the dashboard):
  //   SUPADATA_API_KEY, GEMINI_API_KEY, TP_TOKEN (Travelpayouts API token), SERPAPI_KEY (Google Flights/Hotels), GOOGLE_CLIENT_SECRET (Google sign-in),
  //   DUFFEL_TOKEN (live airline fares + hosted checkout)
}
