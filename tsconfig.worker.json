{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["worker", "shared", "tests"],
  // Regression repros mix worker and browser code (React, fetch stubs); vitest runs them without the worker types.
  // The email log-in flow test runs the real migrations in node:sqlite (Node types), so it is excluded too.
  "exclude": ["tests/regressions", "tests/email-login.test.ts"]
}
